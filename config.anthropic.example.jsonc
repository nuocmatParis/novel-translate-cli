    "anthropic": {
      "type": "anthropic",
      "api_key_env": "NOVEL_TRANSLATE_API_KEY",
      "models": [{"name": "YOUR_CLAUDE_MODEL_ID"}]
    }
  },
  "budget": {"book_usd": 0}
}
